{
  "name": "judgepool",
  "version": "0.1.0",
  "description": "Build a relevance judgment set for RAG retrieval in the browser: pool several retrieval runs, judge blind with the keyboard, compare systems with trec_eval-identical metrics and judged@k pooling-bias warnings.",
  "license": "MIT",
  "type": "module",
  "keywords": ["rag", "retrieval", "qrels", "relevance-judgment", "pooling", "ndcg", "trec", "evaluation"],
  "bin": { "judgepool": "bin/judgepool.mjs" },
  "files": ["dist", "bin", "!bin/*.test.ts", "README.md", "README.ko.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepack": "npm run build",
    "start": "npm run build && node bin/judgepool.mjs",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "idb": "8.0.4",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
